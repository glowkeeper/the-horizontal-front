{
  "name": "the-horizontal-front",
  "version": "1.0.0",
  "description": "**Seize the Means of Relaxation.**",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "check:policy": "node scripts/check-project-policy.mjs",
    "check:static": "node scripts/check-static-build.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "generate:site": "node scripts/generate-site-pages.mjs",
    "test": "vitest run",
    "dev": "npm run generate:site && vite",
    "preview": "vite preview",
    "build": "npm run generate:site && npm run check:policy && npm run validate:content && tsc --noEmit && vite build && node scripts/finalize-static-build.mjs && npm run check:static",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glowkeeper/the-horizontal-front.git"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/glowkeeper/the-horizontal-front/issues"
  },
  "homepage": "https://thehorizontalfront.org",
  "dependencies": {
    "phaser": "^4.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "marked": "^16.4.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
